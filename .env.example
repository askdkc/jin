APP_NAME=Jin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

IP_RESTRICTION_ENABLED=false
ALLOWED_IPS=127.0.0.1,::1
TRUSTED_PROXIES=

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
UPLOAD_MAX_FILE_MB=200
UPLOAD_MAX_FILES=20
UPLOAD_MAX_REQUEST_MB=500
QUEUE_CONNECTION=database

STORED_FILE_CONTENT_ENABLED=false
STORED_FILE_CONTENT_MARKITDOWN_PATH=markitdown
STORED_FILE_CONTENT_PROCESS_TIMEOUT=120
STORED_FILE_CONTENT_JOB_TIMEOUT=180
STORED_FILE_CONTENT_PROCESSING_LEASE_SECONDS=300
STORED_FILE_CONTENT_MAX_SOURCE_BYTES=52428800
STORED_FILE_CONTENT_MAX_OUTPUT_BYTES=16777216
STORED_FILE_CONTENT_MAX_INDEXED_BYTES=2097152

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8088
REVERB_SERVER_PORT=8088
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=jin.test,localhost

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ONLYOFFICE_ENABLED=false
ONLYOFFICE_DOCUMENT_SERVER_URL=http://127.0.0.1:8081
ONLYOFFICE_PUBLIC_URL=http://127.0.0.1:8081
APP_ONLYOFFICE_INTERNAL_URL=http://host.container.internal:8000
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_INSTANCE_ID=jin-local
ONLYOFFICE_INTERNAL_DOWNLOAD_TTL=300
ONLYOFFICE_HEALTHCHECK_TIMEOUT=3
ONLYOFFICE_MAX_FILE_SIZE_BYTES=209715200
ONLYOFFICE_DOCUMENT_SERVER_MAX_DOWNLOAD_BYTES=209715200
ONLYOFFICE_ALLOW_DOWNLOAD=false
ONLYOFFICE_ALLOW_PRINT=false
ONLYOFFICE_ALLOW_COPY=true
